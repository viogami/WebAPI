# SaaS 平台请在项目的环境变量面板中设置以下值，不要提交真实 .env 文件。
# PORT 由多数平台自动注入；本地可留空以使用 conf/config.yaml 中的 8080。
PORT=

# 可选：未配置时对应 AI 接口返回服务未配置状态。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=your_deepseek_api_key

# 仅当 conf/config.yaml 中 ch.enabled 为 true 时必填。
CH_API_DATABASE_URL=postgres://username:password@host:5432/database?sslmode=require
CH_API_PASSWORD_PEPPER=replace_with_a_long_random_secret
CH_API_ALLOWED_ORIGIN=https://your-frontend.example.com
